{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "feat/secure-vercel-api": false,
      "docs/ey-assessment-finalization": false
    }
  },
  "functions": {
    "api/*.ts": { "maxDuration": 15 }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
